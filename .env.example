# Copie para .env e preencha. O .env nunca deve ser versionado.

# Jira (só para `--jira`; sem isso a fixture fictícia é usada)
JIRA_BASE_URL=https://SUA-EMPRESA.atlassian.net
JIRA_EMAIL=usuario@empresa.com
JIRA_API_TOKEN=
# Filtro JQL opcional somado à busca (ex.: project = BILL)
JIRA_JQL_EXTRA=

# Regras
JORNADA_INICIO=09:00
JORNADA_FIM=18:00
ALMOCO_INICIO=12:00
ALMOCO_MIN=60
STATUS_TRABALHO=In Progress,Em andamento,Em Desenvolvimento,Code Review
DIAS_CARD_PARADO=3
FUSO=America/Sao_Paulo

# Notificações
EMAIL_RH=rh@empresa.com
EMAIL_REMETENTE=apontamento@empresa.com
SMTP_HOST=smtp.empresa.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
